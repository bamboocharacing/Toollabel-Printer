<Window x:Class="ToollaberPrinter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToollaberPrinter"
        mc:Ignorable="d"
        Title="Werkzeugtabelle" Height="450" Width="800">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    
    <TabControl>
        <!-- DMU 50T -->
        <TabItem Header="DMU 50T">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <ListView ItemsSource="{Binding ToolsDMU50T}" SelectedItem="{Binding SelectedToolDMU50T}" FontFamily="Consolas" FontSize="14">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Place" Width="60" DisplayMemberBinding="{Binding Place}" />
                                <GridViewColumn Header="Tool" Width="80" DisplayMemberBinding="{Binding Tool}" />
                                <GridViewColumn Header="Length" Width="110" DisplayMemberBinding="{Binding Length}" />
                                <GridViewColumn Header="Radius" Width="110" DisplayMemberBinding="{Binding Radius}" />
                                <GridViewColumn Header="Corner Radius" Width="110" DisplayMemberBinding="{Binding CornerRadius}" />
                                <GridViewColumn Header="Type" Width="80" DisplayMemberBinding="{Binding Type}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <Grid Grid.Row="1">
                    <Button Content="Print" Command="{Binding PrintToolLabelDMU50T}" />
                </Grid>
            </Grid>
        </TabItem>
        
        <!-- DMU 50V -->
        <TabItem Header="DMU 50V">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <ListView ItemsSource="{Binding ToolsDMU50V}" SelectedItem="{Binding SelectedToolDMU50V}" FontFamily="Consolas" FontSize="14">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Place" Width="60" DisplayMemberBinding="{Binding Place}" />
                                <GridViewColumn Header="Tool" Width="80" DisplayMemberBinding="{Binding Tool}" />
                                <GridViewColumn Header="Length" Width="110" DisplayMemberBinding="{Binding Length}" />
                                <GridViewColumn Header="Radius" Width="110" DisplayMemberBinding="{Binding Radius}" />
                                <GridViewColumn Header="Corner Radius" Width="110" DisplayMemberBinding="{Binding CornerRadius}" />
                                <GridViewColumn Header="Type" Width="80" DisplayMemberBinding="{Binding Type}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

                <Grid Grid.Row="1">
                    <Button Content="Print" Command="{Binding PrintToolLabelDMU50V}" />
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
